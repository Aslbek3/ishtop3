# Serverga boradigan fayllar doim LF bilan saqlansin.
# Windows'da CRLF bo'lib ketsa, Linux'da bash "\r: command not found" xatosi beradi.
*.sh            text eol=lf
*.conf          text eol=lf
*.service       text eol=lf

# Veb fayllar ham bir xil bo'lsin
*.html          text eol=lf
*.css           text eol=lf
*.js            text eol=lf
*.json          text eol=lf
*.md            text eol=lf
